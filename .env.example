DISCORD_TOKEN=put-your-bot-token-here
BOT_OWNER_ID=123456789012345678
TOKEN_ENCRYPTION_KEY=replace-with-32-byte-base64-key
# 비우면 DAWN이 참가한 모든 서버에서 명령을 등록합니다.
GUILD_IDS=
DATABASE_PATH=data.json
CTF_MONITOR_INTERVAL_SECONDS=120
# 기본값 false. 내부망에 직접 설치한 HTTPS CTFd를 Pull해야 할 때만 true로 바꾸세요.
CTF_ALLOW_PRIVATE_HOSTS=false
