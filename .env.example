# 필수
DISCORD_TOKEN=put-your-bot-token-here
BOT_OWNER_ID=123456789012345678

# 쉼표로 여러 서버 지정. 비우면 봇이 참가한 서버에 등록합니다.
GUILD_IDS=

# 통합 데이터 저장(JSON). 컨테이너에서는 /data/data.json 권장
DATABASE_PATH=data.json

# 입장/퇴장 로그 기능에서만 필요
ENABLE_LOGGING_INTENTS=false

# 행사 수집
SYNC_INTERVAL_MINUTES=180
CTF_MONITOR_INTERVAL_SECONDS=120
LOOKAHEAD_DAYS=365
SOURCE_TIMEOUT_MS=20000
SOURCE_CONCURRENCY=2
NEWS_LIMIT=12
ENABLE_KCTF=false
ENABLE_TRANSLATION=true
ENABLE_AUTO_DISCOVERY=true
EXTRA_FEED_URLS=
DISCOVERY_FEED_URLS=
EVENT_PAGE_URLS=

# 검색 API: 키가 있는 제공자만 사용
ENABLE_SEARCH_API_DISCOVERY=true
SEARCH_API_MAX_RESULTS=5
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
GOOGLE_API_KEY=
GOOGLE_CSE_ID=
BING_API_KEY=
BING_ENDPOINT=https://api.bing.microsoft.com/v7.0/search
