{
  "name": "ctf-phasor",
  "version": "1.0.0",
  "description": "CTF workspace, challenge threads, contribution scoring, and low-impact monitoring for Discord",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20.18.1"
  },
  "scripts": {
    "build": "tsc",
    "start": "node --max-old-space-size=64 --expose-gc dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run build && npm test"
  },
  "dependencies": {
    "cheerio": "1.0.0",
    "discord.js": "^14.26.4",
    "dotenv": "^17.2.3",
    "fast-xml-parser": "^5.2.5",
    "iconv-lite": "^0.6.3"
  },
  "devDependencies": {
    "@types/node": "^22.19.11",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "undici": "^6.27.0"
  }
}
